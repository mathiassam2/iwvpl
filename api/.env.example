# IWVPL API — local configuration
#
# Copy to api/.env and fill in. Never commit api/.env.
# On Render, set these as environment variables in the dashboard instead;
# nothing here should be copied over wholesale.

# --- server -----------------------------------------------------------------

# 8080 matches Render's default for a Node web service and keeps the two
# environments identical. Change freely if something else needs the port.
PORT=8080

# Render injects RENDER=1, which flips NODE_ENV to production. Set explicitly
# to override.
# NODE_ENV=development

# 127.0.0.1 keeps the dev server off your network. Widen only deliberately.
HOST=127.0.0.1

# Apply pending migrations when the server starts. Correct for one instance.
# Set to false before scaling past one replica and migrate as a deploy step.
MIGRATE_ON_BOOT=true

# --- database (TiDB Cloud) --------------------------------------------------

# TiDB Cloud → your cluster → "Connect" → the MySQL tab. The host looks like
# <prefix>.root.region.aws.tidbcloud.com and the port is 4000.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=

# TiDB requires TLS on every cluster, so leave this true.
DB_SSL=true

# The CA cert from TiDB Cloud's "Download the CA cert" button. Accepts either a
# path relative to api/ (certs/ is gitignored) or the PEM text itself with
# literal \n escapes. Unset still connects, encrypted but unverified.
# Download it, put it at api/certs/tidb-ca.pem, then uncomment:
# DB_SSL_CA=certs/tidb-ca.pem

# Connection pool size. Raise it only if you have measured a bottleneck; TiDB
# handles far more concurrent clients than this.
DB_POOL_SIZE=10

# --- admin gate -------------------------------------------------------------

# HTTP basic auth in front of /admin. This exists to keep the admin JavaScript
# unfetchable, not to identify users — real per-user auth is the users table.

# Set to false to serve /admin unprotected. Only ever do this on localhost.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin

# Must be at least 12 characters in production; the server refuses to boot
# otherwise. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# --- player & manager accounts -----------------------------------------------

# Separate from the admin gate above. These are individual logins on the public
# site, stored as bcrypt hashes in `users` with revocable rows in `sessions`.
# Sign-up is self-service; owner/admin accounts are inserted by hand, never by
# the public form.

# Cookie name. Changing it signs everyone out, because the old cookie is still
# sent but no longer read.
# AUTH_COOKIE=iwvpl_session

# How long a session lasts. Long by design: this is not a daily product, and
# sessions are revocable server-side, so a long life is not a security cost.
# AUTH_SESSION_DAYS=30

# bcrypt cost. 10 is the library default and takes ~100ms per login. Raising it
# mostly slows sign-in, since the hash is only computed on register and login.
# AUTH_BCRYPT_ROUNDS=10

# Extra origins allowed to send *credentialed* requests, comma separated.
# PUBLIC_SITE_ORIGIN is already honoured. Add entries only for other frontends
# that need to sign in — the session cookie is SameSite=None in production, so
# it will be sent to this API by any site that asks.
# AUTH_EXTRA_ORIGINS=https://another.example