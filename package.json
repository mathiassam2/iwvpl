{
  "name": "iwvpl-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc -b --noCheck && node scripts/audit-iw-mark.mjs && vite build",
    "build:ghpages": "tsc -b --noCheck && node scripts/audit-iw-mark.mjs && vite build",
    "preview": "vite preview --port 3000 --host",
    "typecheck": "tsc -b && node scripts/audit-iw-mark.mjs && node scripts/audit-arbitrary.mjs",
    "deploy:beta": "node scripts/deploy-cpanel.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
