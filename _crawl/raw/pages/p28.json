 SPORTSPRESS (DITANAM LANGSUNG KE PHP)\r\n======================================================== -->\r\n<style>\r\n\/* 1. MENGATUR WADAH UTAMA (RATA TENGAH VERTIKAL) *\/\r\n.match-single-content {\r\n    display: flex !important;\r\n    flex-direction: column !important;\r\n    justify-content: center !important;\r\n    align-items: center !important;\r\n    min-height: 180px; \r\n    padding: 20px 0;\r\n}\r\n\r\n\/* 2. MENGATUR TANGGAL & WAKTU DI ATAS 'VS' *\/\r\n.match-date-time-wrap {\r\n    text-align: center;\r\n    margin-bottom: 15px;\r\n    z-index: 10;\r\n    width: 100%;\r\n}\r\n\r\n.match-date-text {\r\n    display: block !important;\r\n    color: #f03c3c !important; \r\n    font-weight: bold !important;\r\n    font-size: 15px !important;\r\n    margin-bottom: 5px !important;\r\n}\r\n\r\n.match-time-text {\r\n    display: block !important;\r\n    font-weight: bold !important;\r\n    color: #ffffff !important; \r\n}\r\n\r\n\/* 3. MENGATUR KOLOM LOGO & VS (Kiri - Tengah - Kanan) *\/\r\n.match-scores {\r\n    width: 100%;\r\n}\r\n\r\n.match-scores .sp-event-logos.sp-event-logos-2 {\r\n    display: grid !important;\r\n    grid-template-columns: 1fr auto 1fr !important;\r\n    align-items: center !important; \r\n    width: 100%;\r\n    gap: 20px;\r\n}\r\n\r\n\/* Mengatur Tim Kiri (Rata kanan mendekati VS) *\/\r\n.match-scores .sp-event-logos-2 .sp-team-logo:first-of-type {\r\n    display: flex !important;\r\n    align-items: center;\r\n    justify-content: flex-end; \r\n    gap: 15px; \r\n    text-align: right;\r\n}\r\n\r\n\/* Mengatur Tim Kanan (Rata kiri mendekati VS) *\/\r\n.match-scores .sp-event-logos-2 .sp-team-logo:last-of-type {\r\n    display: flex !important;\r\n    align-items: center;\r\n    justify-content: flex-start;\r\n    gap: 15px; \r\n    text-align: left;\r\n}\r\n\r\n\/* Memperbesar ukuran Logo Tim *\/\r\n.match-scores .sp-event-logos-2 .sp-team-logo img {\r\n    width: 110px !important; \r\n    height: auto !important;\r\n    max-width: none !important;\r\n    object-fit: contain;\r\n}\r\n\r\n\/* 4. GAYA TOMBOL MATCH DETAILS *\/\r\n.match-bottom-action .action-item {\r\n    display: block !important;\r\n    width: 100% !important;\r\n    background-color: #f03c3c !important;\r\n    color: #ffffff !important;\r\n    text-align: center !important;\r\n    padding: 10px 0 !important;\r\n    font-weight: bold !important;\r\n    text-transform: uppercase !important;\r\n    border-radius: 0 !important;\r\n}\r\n.match-bottom-action .action-item:hover {\r\n    background-color: #d12e2e !important;\r\n}\r\n\r\n\/* ========================================================\r\n   5. TAMPILAN RESPONSIVE BULLETPROOF (TABLET & HANDPHONE)\r\n======================================================== *\/\r\n@media (max-width: 768px) {\r\n    .match-single-content {\r\n        padding: 15px !important;\r\n        min-height: auto !important;\r\n        box-sizing: border-box !important;\r\n        overflow: hidden !important; \/* Mencegah layar tergeser ke samping *\/\r\n    }\r\n    \r\n    \/* MENGUBAH GRID MENJADI FLEXBOX PERSENTASE DI HP *\/\r\n    .match-scores .sp-event-logos.sp-event-logos-2 {\r\n        display: flex !important;\r\n        flex-direction: row !important;\r\n        justify-content: space-between !important;\r\n        align-items: flex-start !important; \/* Rata atas *\/\r\n        width: 100% !important;\r\n        gap: 0 !important;\r\n    }\r\n\r\n    \/* Tim Kiri & Kanan Maksimal 40% Lebar Layar *\/\r\n    .match-scores .sp-event-logos-2 .sp-team-logo:first-of-type,\r\n    .match-scores .sp-event-logos-2 .sp-team-logo:last-of-type {\r\n        width: 42% !important; \/* Pengunci Lebar *\/\r\n        display: flex !important;\r\n        flex-direction: column !important;\r\n        align-items: center !important;\r\n        justify-content: flex-start !important;\r\n        text-align: center !important;\r\n        gap: 8px !important;\r\n    }\r\n    \r\n    \/* VS Berada di Tengah sebesar 16% *\/\r\n    .match-scores .sp-event-logos-2 > *:not(.sp-team-logo) {\r\n        width: 16% !important;\r\n        display: flex !important;\r\n        justify-content: center !important;\r\n        align-items: center !important;\r\n        margin-top: 25px !important; \/* Menurunkan VS agar sejajar dengan logo *\/\r\n    }\r\n    \r\n    \/* Memaksa posisi logo selalu di atas teks untuk tim sebelah kiri *\/\r\n    .match-scores .sp-event-logos-2 .sp-team-logo img {\r\n        order: -1 !important;\r\n        width: 65px !important; \/* Logo dikecilkan *\/\r\n        height: auto !important;\r\n        max-width: 100% !important;\r\n    }\r\n\r\n    \/* Teks nama tim di HP dipaksa patah jika kepanjangan *\/\r\n    .match-scores .sp-team-name {\r\n        font-size: 11px !important;\r\n        line-height: 1.3 !important;\r\n        white-space: normal !important;\r\n        overflow-wrap: break-word !important; \/* Mantra anti luber *\/\r\n        word-wrap: break-word !important;\r\n    }\r\n    \r\n    \/* Menyesuaikan ukuran font Tanggal & Waktu di HP *\/\r\n    .match-date-text { font-size: 12px !important; }\r\n    .match-time-text { font-size: 13px !important; }\r\n}\r\n<\/style>\r\n\r\n\r\n\t\t<\/div>\r\n\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-340884a elementor-section-stretched elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"340884a\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;stretch_section&quot;:&quot;section-stretched&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-178277f\" data-id