/* Start custom CSS for wp-widget-sportspress-league-table, class: .elementor-element-47244f1 *//* ====================================================
   1. MENGATUR URUTAN ANGKA (RANKING) SPORTSPRESS
==================================================== */
table.sp-league-table tbody {
    counter-reset: sp-rank;
}
table.sp-league-table tbody tr {
    counter-increment: sp-rank;
}
table.sp-league-table tbody tr td.data-rank {
    font-size: 0 !important; 
}
table.sp-league-table tbody tr td.data-rank::before {
    content: counter(sp-rank);
    font-size: 16px;
    font-weight: bold;
}

/* ====================================================
   2. PENGATURAN TABEL UNTUK MOBILE & TABLET
==================================================== */
@media only screen and (max-width: 768px) {
    /* Memastikan tabel bisa di-swipe horizontal */
    .sp-template,
    .sp-template-league-table,
    .sp-table-wrapper {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        display: block;
        width: 100%;
    }

    /* Mengecilkan jarak (padding) agar hemat ruang */
    table.sp-league-table th,
    table.sp-league-table td {
        padding: 8px 6px !important;
        font-size: 12px !important;
    }

    /* Merapikan kolom 'Club' agar teks memanjang ke samping */
    table.sp-league-table td.data-name {
        min-width: 160px !important;
        white-space: nowrap !important;
        text-align: left !important;
    }

    /* Menyejajarkan logo klub dengan teks */
    table.sp-league-table td.data-name img {
        max-width: 22px !important;
        height: auto !important;
        display: inline-block !important;
        vertical-align: middle !important;
        margin-right: 8px !important;
        margin-bottom: 0 !important;
    }

    /* Penyesuaian ukuran angka ranking di versi mobile */
    table.sp-league-table td.data-rank::before,
    table.sp-league-table td.data-rank {
        font-size: 13px !important;
    }
}/* End custom CSS */</style>[{"id":18,"date":"2023-06-04T09:05:17","date_gmt":"2023-06-04T09:05:17","guid":{"rendered":"http:\/\/192.168.0.6\/kester\/?page_id=18"},"modified":"2026-08-23T05:22:11","modified_gmt":"2026-08-22T21:22:11","slug":"homepage-1","status":"publish","type":"page","link":"https:\/\/www.iwvpl.asia\/","title":{"rendered":"Home One"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"18\" class=\"elementor elementor-18\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-898b8fe e-con-full e-flex e-con e-parent\" data-id=\"898b8fe\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-ea30878 e-con-full e-flex e-con e-child\" data-id=\"ea30878\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-41c0f6d elementor-widget elementor-widget-slider_revolution\" data-id=\"41c0f6d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"slider_revolution.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n\t\t<div class=\"wp-block-themepunch-revslider\">\n\t\t\t<!-- START Slider 1 REVOLUTION SLIDER 6.7.58 --><p class=\"rs-p-wp-fix\"><\/p>\n\t\t\t<rs-module-wrap id=\"rev_slider_2_1_wrapper\" data-source=\"gallery\" style=\"visibility:hidden;background:transparent;padding:0;margin:0px auto;margin-top:0;margin-bottom:0;\">\n\t\t\t\t<rs-module id=\"rev_slider_2_1\" style=\"\" data-version=\"6.7.58\">\n\t\t\t\t\t<rs-slides style=\"overflow: hidden; position: absolute;\">\n\t\t\t\t\t\t<rs-slide style=\"position: absolute;\" data-key=\"rs-2\" data-title=\"Slide\" data-thumb=\"\/\/www.iwvpl.asia\/wp-content\/uploads\/2026\/08\/F4B671E0-1CE7-467C-B0F0-CD792180A95B-50x100.webp\" data-in=\"o:0;\" data-out=\"a:false;\" data-sloop=\"s:2500;e:4500;\">\n\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" src=\"\/\/www.iwvp