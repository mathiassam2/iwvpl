portant;\r\n        justify-content: space-between !important;\r\n        align-items: flex-start !important; \/* Rata atas *\/\r\n        width: 100% !important;\r\n        gap: 0 !important;\r\n    }\r\n\r\n    \/* Tim Kiri & Kanan Maksimal 40% Lebar Layar *\/\r\n    .match-scores .sp-event-logos-2 .sp-team-logo:first-of-type,\r\n    .match-scores .sp-event-logos-2 .sp-team-logo:last-of-type {\r\n        width: 42% !important; \/* Pengunci Lebar *\/\r\n        display: flex !important;\r\n        flex-direction: column !important;\r\n        align-items: center !important;\r\n        justify-content: flex-start !important;\r\n        text-align: center !important;\r\n        gap: 8px !important;\r\n    }\r\n    \r\n    \/* VS Berada di Tengah sebesar 16% *\/\r\n    .match-scores .sp-event-logos-2 > *:not(.sp-team-logo) {\r\n        width: 16% !important;\r\n        display: flex !important;\r\n        justify-content: center !important;\r\n        align-items: center !important;\r\n        margin-top: 25px !important; \/* Menurunkan VS agar sejajar dengan logo *\/\r\n    }\r\n    \r\n    \/* Memaksa posisi logo selalu di atas teks untuk tim sebelah kiri *\/\r\n    .match-scores .sp-event-logos-2 .sp-team-logo img {\r\n        order: -1 !important;\r\n        width: 65px !important; \/* Logo dikecilkan *\/\r\n        height: auto !important;\r\n        max-width: 100% !important;\r\n    }\r\n\r\n    \/* Teks nama tim di HP dipaksa patah jika kepanjangan *\/\r\n    .match-scores .sp-team-name {\r\n        font-size: 11px !important;\r\n        line-height: 1.3 !important;\r\n        white-space: normal !important;\r\n        overflow-wrap: break-word !important; \/* Mantra anti luber *\/\r\n        word-wrap: break-word !important;\r\n    }\r\n    \r\n    \/* Menyesuaikan ukuran font Tanggal & Waktu di HP *\/\r\n    .match-date-text { font-size: 12px !important; }\r\n    .match-time-text { font-size: 13px !important; }\r\n}\r\n<\/style>\r\n\r\n\r\n\t\t<\/div>\r\n\r\