   CUSTOM CSS ULTIMATE MEMBER PROFILE
   ========================================= */

/* 1. Container Profil Utama (Mengecilkan ukuran keseluruhan body) */
.um-profile.um {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.06);
    padding: 30px 20px; /* Padding dibuat lebih efisien */
    border: 1px solid #f1f5f9;
    max-width: 1000px !important; /* DIKECILKAN: Batas maksimal lebar kotak (sebelumnya 800px) */
    margin: 0 auto 40px auto; 
}

/* 2. Foto Profil & Nama */
.um-profile-photo a.um-profile-photo-img {
    border: 4px solid #ffffff;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    transition: transform 0.3s ease;
}

.um-profile-photo a.um-profile-photo-img:hover {
    transform: scale(1.05);
}

.um-name a {
    color: #1e293b !important;
    font-size: 26px !important;
    font-weight: 800 !important;
    text-decoration: none !important;
    letter-spacing: -0.5px;
}

/* 3. Menghilangkan garis bawah default UM & mengatur jarak */
.um-profile-body .um-field {
    border-bottom: none !important;
    margin-bottom: 22px;
    padding: 0 !important;
}

/* 4. Gaya Label (Judul seperti "EA ID", "Discord ID") */
.um-field-label {
    margin-bottom: 8px !important;
}

.um-field-label label {
    font-size: 12px !important;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #64748b !important;
    font-weight: 700 !important;
}

/* 5. Gaya Kotak Nilai (Isi data dari user) */
.um-field-value {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    color: #0f172a;
    font-size: 15px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.um-field-value:hover {
    border-color: #cbd5e1;
    background-color: #f1f5f9;
}

/* 6. Ikon Pengaturan (Gear Icon) */
.um-profile-meta .um-cog {
    color: #94a3b8 !important;
    font-size: 20px !important;
    transition: color 0.3s ease;
}

.um-profile-meta .um-cog:hover {
    color: #3b82f6 !important;
}

/* 7. Penyesuaian warna link email agar senada */
.um-field-value a {
    color: #ef4444 !important; /* Warna merah seperti di gambar, bisa diganti ke #3b82f6 untuk biru */
    text-decoration: none;
    font-weight: 600;
}/* End custom CSS */</style>[{"id":4881,"date":"2026-08-06T17:46:25","date_gmt":"2026-08-06T09:46:25","guid":{"rendered":"https:\/\/www.iwvpl.asia\/user\/"},"modified":"2026-09-03T17:27:16","modified_gmt":"2026-09-03T09:27:16","slug":"dashboard","status":"publish","type":"page","link":"https:\/\/www.iwvpl.asia\/dashboard\/","title":{"rendered":"DASHBOARD"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"4881\" class=\"elementor elementor-4881\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-222a2a0 e-flex e-con-boxed e-con e-parent\" data-id=\"222a2a0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-d562cc6 e-con-full e-flex e-con e-child\" data-id=\"d562cc6\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1573bfe elementor-widget elementor-widget-button\" data-id=\"1573bfe\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-size-sm\" role=\"button\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t<span class=\"elementor-button-icon\">\n\t\t\t\t<i aria-hidden=\"true\" class=\"fas fa-user-circle\"><\/i>\t\t\t<\/span>\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">View Profile<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8f8e2cd elementor-widget__width-inherit elementor-widget elementor-widget-shortcode\" data-id=\"8f8e2cd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=