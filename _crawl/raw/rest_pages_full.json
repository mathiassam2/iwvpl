/* Start custom CSS for wp-widget-sportspress-league-table, class: .elementor-element-47244f1 *//* ====================================================
   1. MENGATUR URUTAN ANGKA (RANKING) SPORTSPRESS
==================================================== */
table.sp-league-table tbody {
    counter-reset: sp-rank;
}
table.sp-league-table tbody tr {
    counter-increment: sp-rank;
}
table.sp-league-table tbody tr td.data-rank {
    font-size: 0 !important; 
}
table.sp-league-table tbody tr td.data-rank::before {
    content: counter(sp-rank);
    font-size: 16px;
    font-weight: bold;
}

/* ====================================================
   2. PENGATURAN TABEL UNTUK MOBILE & TABLET
==================================================== */
@media only screen and (max-width: 768px) {
    /* Memastikan tabel bisa di-swipe horizontal */
    .sp-template,
    .sp-template-league-table,
    .sp-table-wrapper {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        display: block;
        width: 100%;
    }

    /* Mengecilkan jarak (padding) agar hemat ruang */
    table.sp-league-table th,
    table.sp-league-table td {
        padding: 8px 6px !important;
        font-size: 12px !important;
    }

    /* Merapikan kolom 'Club' agar teks memanjang ke samping */
    table.sp-league-table td.data-name {
        min-width: 160px !important;
        white-space: nowrap !important;
        text-align: left !important;
    }

    /* Menyejajarkan logo klub dengan teks */
    table.sp-league-table td.data-name img {
        max-width: 22px !important;
        height: auto !important;
        display: inline-block !important;
        vertical-align: middle !important;
        margin-right: 8px !important;
        margin-bottom: 0 !important;
    }

    /* Penyesuaian ukuran angka ranking di versi mobile */
    table.sp-league-table td.data-rank::before,
    table.sp-league-table td.data-rank {
        font-size: 13px !important;
    }
}/* End custom CSS */</style>[{"id":6226,"date":"2026-08-25T18:36:37","date_gmt":"2026-08-25T10:36:37","guid":{"rendered":"https:\/\/www.iwvpl.asia\/?page_id=6226"},"modified":"2026-08-25T18:40:47","modified_gmt":"2026-08-25T10:40:47","slug":"terms-of-use-policies","status":"publish","type":"page","link":"https:\/\/www.iwvpl.asia\/terms-of-use-policies\/","title":{"rendered":"Terms of Use &amp; Policies"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\">Terms of Use<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Welcome to the official website of Island-Wide Virtual Premier League (IWVPL).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">By accessing this website, registering for an IWVPL competition, or using any of our services, you agree to comply with these Terms of Use. If you do not agree with these terms, please discontinue the use of our website and services.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">IWVPL is an independent esports organization dedicated to delivering competitive EA SPORTS FC tournaments and leagues across Singapore, Malaysia, and Indonesia. Our goal is to provide a fair, competitive, and enjoyable environment for every participant.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Users are expected to provide accurate registration information, comply with all league rules, respect fellow participants, and maintain good sportsmanship throughout every competition.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">IWVPL reserves the right to modify competition formats, league schedules, rules, website content, and these Terms of Use at any time. Continued use of our website constitutes acceptance of any updates.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Any participant found cheating, abusing game mechanics, engaging in match-fixing, using offensive language, or violating IWVPL rules may be suspended or permanently removed from all IWVPL competitions.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">All logos, graphics, league branding, website content, videos, fixtures, and promotional materials are the intellectual property of IWVPL unless otherwise stated and may not be reproduced without written permission.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">IWVPL operates independently and is not affiliated with, endorsed by, or sponsored by Electronic Arts Inc., EA SPORTS, UEFA, the Premier League, or any other football governing body unless expressly stated.<br>IWVPL Policies<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">IWVPL is committed to maintaining a professional, transparent, and competitive esports environment.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">All players, team owners, captains, managers, and community members are expected to comply with our official policies throughout every season.<\/p>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n\n\n\n<h2 class=\"wp-block-heading\">Our policies include:<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Fair Play and Competitive Integrity<\/li>\n\n\n\n<li>Player Eligibility and Registration<\/li>\n\n\n\n<li>Team Management<\/li>\n\n\n\n<li>Match Scheduling<\/li>\n\n\n\n<li>Prize Distribution<\/li>\n\n\n\n<li>Code of Conduct<\/li>\n\n\n\n<li>Anti-Cheat Policy<\/li>\n\n\n\n<li>Privacy and Data Protection<\/li>\n\n\n\n<li>Appeals and Disciplinary Procedures<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Participants are responsible for staying informed of the latest policy updates published on the official IWVPL website and communication channels.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Failure to comply with IWVPL policies may result in warnings, point deductions, match forfeits, suspension, or permanent removal from competitions.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">IWVPL reserves the right to investigate any suspected rule violations and make final decisions in the best interest of competitive integrity.<br>Contact Us<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Thank you for your interest in the Island-Wide Virtual Premier League.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you are a player, team owner, sponsor, content creator, or community member, our team is here to assist you.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Please contact us for enquiries relating to:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>League Registration<\/li>\n\n\n\n<li>Tournament Information<\/li>\n\n\n\n<li>Sponsorship Opportunities<\/li>\n\n\n\n<li>Partnership Enquiries<\/li>\n\n\n\n<li>Media Requests<\/li>\n\n\n\n<li>Technical Support<\/li>\n\n\n\n<li>Rule Clarifications<\/li>\n\n\n\n<li>General Feedback<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">Official Website<br><a href=\"https:\/\/iwvpl.asia\/\">https:\/\/iwvpl.asia\/<\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Email<br><a href=\"mailto:iwvplofficial@gmail.com\">iwvplofficial@gmail.com<\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Discord<br><a href=\"https:\/\/discord.gg\/3fHDGz8SFZ\" data-type=\"link\" data-id=\"https:\/\/discord.gg\/3fHDGz8SFZ\">ISLAND-WIDE VIRTUAL PREMIER LEAGUE<\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Our administration team aims to respond to all enquiries as quickly as possible during business hours.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Terms of Use Welcome to the official website of Island-Wide Virtual Premier League (IWVPL). By accessing this website, registering for an IWVPL competition, or using any of our services, you agree to comply with these Terms of Use. If you do not agree with these terms, please discontinue the use of our website and services&#8230;.<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-6226","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/www.iwvpl.asia\/wp-json\/wp\/v2\/pages\/6226","targetHints":{"allo