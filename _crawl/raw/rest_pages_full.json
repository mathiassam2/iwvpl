   CUSTOM CSS ULTIMATE MEMBER PROFILE
   ========================================= */

/* 1. Container Profil Utama (Mengecilkan ukuran keseluruhan body) */
.um-profile.um {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.06);
    padding: 30px 20px; /* Padding dibuat lebih efisien */
    border: 1px solid #f1f5f9;
    max-width: 1000px !important; /* DIKECILKAN: Batas maksimal lebar kotak (sebelumnya 800px) */
    margin: 0 auto 40px auto; 
}

/* 2. Foto Profil & Nama */
.um-profile-photo a.um-profile-photo-img {
    border: 4px solid #ffffff;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    transition: transform 0.3s ease;
}

.um-profile-photo a.um-profile-photo-img:hover {
    transform: scale(1.05);
}

.um-name a {
    color: #1e293b !important;
    font-size: 26px !important;
    font-weight: 800 !important;
    text-decoration: none !important;
    letter-spacing: -0.5px;
}

/* 3. Menghilangkan garis bawah default UM & mengatur jarak */
.um-profile-body .um-field {
    border-bottom: none !important;
    margin-bottom: 22px;
    padding: 0 !important;
}

/* 4. Gaya Label (Judul seperti "EA ID", "Discord ID") */
.um-field-label {
    margin-bottom: 8px !important;
}

.um-field-label label {
    font-size: 12px !important;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #64748b !important;
    font-weight: 700 !important;
}

/* 5. Gaya Kotak Nilai (Isi data dari user) */
.um-field-value {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    color: #0f172a;
    font-size: 15px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.um-field-value:hover {
    border-color: #cbd5e1;
    background-color: #f1f5f9;
}

/* 6. Ikon Pengaturan (Gear Icon) */
.um-profile-meta .um-cog {
    color: #94a3b8 !important;
    font-size: 20px !important;
    transition: color 0.3s ease;
}

.um-profile-meta .um-cog:hover {
    color: #3b82f6 !important;
}

/* 7. Penyesuaian warna link email agar senada */
.um-field-value a {
    color: #ef4444 !important; /* Warna merah seperti di gambar, bisa diganti ke #3b82f6 untuk biru */
    text-decoration: none;
    font-weight: 600;
